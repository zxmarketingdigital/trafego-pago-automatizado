# Setup 6 — Tráfego Pago Meta ADS
# Copie para ~/.operacao-ia/config/meta.env e preencha

# Conta Meta (preenchido automaticamente após OAuth)
META_AD_ACCOUNT_ID=act_XXXXXXXXX
META_BUSINESS_ID=
META_PAGE_ID=
META_PIXEL_ID=

# Bônus 1 — API de Conversões (CAPI)
# Deixe desligado até alinhar o mesmo event_id no Pixel e no servidor.
# CAPI_PIXEL_ID=
# CAPI_TOKEN=
# CAPI_ENABLED=false
# CAPI_TEST_EVENT_CODE=

# Bônus 2 — Relatório diário por e-mail (opt-in)
# REPORT_EMAIL_TO=
# REPORT_EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# REPORT_WINDOW=

# Bônus 3 — Relatório diário no WhatsApp (opt-in)
# Provider recomendado: cloud_api. Alternativa: evolution.
# REPORT_WHATSAPP_PROVIDER=cloud_api
# REPORT_WHATSAPP_TO=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# EVOLUTION_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# REPORT_WINDOW=

# Opcional: integração Supabase (se aluno tem CRM próprio)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Pasta base
OPERACAO_IA_HOME=~/.operacao-ia
